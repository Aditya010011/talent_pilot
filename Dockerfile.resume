FROM python:3.11-slim

# OCR + document deps for ai-resume-parser[full]
RUN apt-get update && apt-get install -y \
    tesseract-ocr \
    tesseract-ocr-eng \
    libgl1 \
    libglib2.0-0 \
    poppler-utils \
    libreoffice-impress \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY server/resume/requirements.txt ./server/resume/
RUN pip install --no-cache-dir -r server/resume/requirements.txt

COPY server/resume/ ./server/resume/

ENV PYTHONPATH=/app/server/resume
ENV HOST=0.0.0.0
ENV PORT=8091

CMD ["python", "server/resume/resume_service.py"]
