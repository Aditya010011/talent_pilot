  "account.deleteConfirmBody": "இது உங்கள் சுயவிவரம், சந்திப்புகள், அமர்வுகள், கேள்விகள் மற்றும் அனைத்து பிற தரவுகளை நிரந்தரமாக நீக்கும். இந்த நடவடிக்கையை திரும்பப் பெற முடியாது.",
  "account.deleteSendCode": "ஆம், உறுதிப்படுத்தல் குறியீட்டை அனுப்பவும்",
  "account.deleteVerifyDescription": "கணக்கு நீக்கத்தை உறுதிப்படுத்த {email}க்கு அனுப்பப்பட்ட உறுதிப்படுத்தல் குறியீட்டை உள்ளிடவும்.",
  "account.verifyAndDelete": "உறுதிப்படுத்தவும் & கணக்கை நீக்கவும்",
  "onboarding.info": "சந்திப்பு தகவல்",
  "onboarding.checklist": "சேகரிப்பு பட்டியல்",
  "onboarding.start": "தொடங்கு",
  "onboarding.cameraEye": "உங்கள் கண்களை கேமராவில் வைத்திருங்கள்",
  "onboarding.startCollecting": "சேகரிக்க தொடங்கு",
  "onboarding.cameraDesc": "இந்த புகைப்படம் நேர்காணல் போது எடுத்த புகைப்படங்களுடன் ஒப்பிடப்படும், எனவே உங்கள் முகம் தெளிவாக இருக்க வேண்டும்.",
  "onboarding.cameraAuth": "புகைப்பட சேகரிக்க அனுமதி தேவை, தயவுசெய்து உலாவி அறிவுறுத்தல்களைப் பின்பற்றவும்.",
  "onboarding.cameraError": "கேமராவை அணுக முடியவில்லை. தயவுசெய்து அனுமதிகளைச் சரிபார்க்கவும்.",
  "onboarding.noCamera": "கேமரா இல்லை?",
  "onboarding.collectPhoto": "புகைப்படத்தை சேகரிக்கவும்",
  "onboarding.mic": "மைக்ரோஃபோன்",
  "onboarding.speakerMic": "ஸ்பீக்கர் & மைக்ரோஃபோன்",
  "onboarding.testMic": "மைக்ரோஃபோனை சோதிக்கவும்",
  "onboarding.micDesc": "உங்கள் ஸ்பீக்கர் மற்றும் மைக்ரோஃபோனை சோதிக்கவும், ஒலியால் சரியாக செயல்படுகிறதா என்பதை உறுதி செய்யவும்.",
  "onboarding.micInstructions": "\"மைக்ரோஃபோனை சோதிக்கவும்\" என்பதை கிளிக் செய்து குரல் முகவரியிடமிருந்து ஒரு செய்தியை கேளுங்கள். பின்னர், ஒலியை சரியாக செயல்படுகிறதா என்பதை உறுதிப்படுத்த உங்கள் பதிலைச் சொல்லுங்கள் — உண்மையான நேர்காணலுக்குப் போலவே.",
  "onboarding.noMic": "மைக்ரோஃபோன் இல்லை?",
  "onboarding.screenUnavailable": "திரை பகிர்வு கிடையாது",
  "onboarding.screenUnavailableDesc": "திரை பகிர்வுக்கு ஒரு டெஸ்க்டாப் உலாவி (Chrome பரிந்துரைக்கப்படுகிறது) தேவை. உங்கள் சாதனத்தில் இந்த படி தானாகவே தவிர்க்கப்பட்டுள்ளது.",
  "onboarding.secureContextError": "இந்த அம்சத்திற்கு பாதுகாப்பான (HTTPS) இணைப்பு தேவை. தயவுசெய்து நிர்வாகியை அணுகவும்.",
  "onboarding.integrityNotices": "உறுதிப்படுத்தல் அறிவுறுத்தல்கள்",
  "onboarding.integrityDesc": "நியாயத்தை உறுதி செய்ய, கீழ்க்காணும் உறுதிப்படுத்தல் நடவடிக்கைகள் இந்த அமர்வின் முழுவதும் செயல்படுத்தப்படும்.",
  "onboarding.chromeNotice": "நேர்காணல் சரியாக நடைபெறுவதற்கு, தயவுசெய்து Chrome இன் சமீபத்திய பதிப்பைப் பயன்படுத்தவும்.",
  "onboarding.submitNotice": "உங்கள் பதில்களை முடித்த பிறகு, அனைத்து கேள்விகளுக்கும் நீங்கள் அவற்றைப் சமர்ப்பித்துள்ளீர்களா என்பதை உறுதிப்படுத்தவும். இல்லையெனில், இது உங்கள் முடிவுகளை பாதிக்கும்.",
  "onboarding.tabTracking": "தாவல் மாற்றம் மற்றும் கவனம் கண்காணிப்பு:",
  "onboarding.tabTrackingDesc": "நேர்காணல் பக்கம் விலகுதல் அல்லது மற்றொரு ஜன்னலுக்கு மாறுதல் தானாகவே கண்டறியப்படும் மற்றும் பதிவு செய்யப்படும். மீண்டும் மீண்டும் விலகுதல் உங்கள் அமர்வை மதிப்பீட்டிற்காக கொடுக்குமாறு குறிக்கிறது.",
  "onboarding.pasteBlocked": "வெளியுறுப்பு ஒட்டுதல் தடைக்கப்பட்டுள்ளது:",
  "onboarding.pasteBlockedDesc": "நேர்காணல் பக்கத்திற்குப் புறமாக உள்ள உள்ளடக்கத்தை ஒட்டுவது அனுமதிக்கப்படவில்லை. நீங்கள் பக்கத்தில் உள்ளே சுதந்திரமாக நகலெடுக்க மற்றும் ஒட்டலாம்.",
  "onboarding.multiScreen": "பல திரை கண்டறிதல்:",
  "onboarding.multiScreenDesc": "நீங்கள் பல கணினி திரைகளை இணைத்துள்ளீர்களா என்பதை அமைப்பு கண்டறிக்கும். தொடங்குவதற்கு முன் கூடுதல் திரைகளை அணைக்கவும் அல்லது отключить செய்யவும்.",
  "onboarding.cameraNotice": "இந்த நேர்காணல் உங்கள் பதிவு புகைப்படத்தை சேகரிக்க மற்றும் உங்கள் நடத்தைப் பிடிக்க கேமராவை தேவைப்படுகிறது. அனைத்து புகைப்படங்களும் தனியுரிமை பாதுகாக்கப்பட்டவை.",
  "onboarding.screenCaptureNotice": "நேர்காணல் முழுவதும் திரை பிடிப்பு நடைபெறும். திரை பிடிப்புக்கு அனுமதி தேவை.",
  "onboarding.distractionNotice": "நேர்காணல் தொடங்குவதற்கு முன், விளம்பரங்கள், செய்தி பாப்-அப்புகள் உள்ள எந்த மென்பொருள் அல்லது வலைப்பக்கம் மூடவும். முழு செயல்முறையின் போது நேர்காணல் பக்கம் விலக வேண்டாம்.",
  "onboarding.agreeNotice": "மேலே உள்ள அறிவுறுத்தல்களுக்கும் நேர்காணல் வழிகாட்டிகளுக்கும் நான் ஒப்புக்கொள்கிறேன்",
  "onboarding.chromeRecommended": "சிறந்த அனுபவத்திற்காக Chrome பரிந்துரைக்கப்படுகிறது.",
  "onboarding.audioConfirmed": "ஒலி உறுதிப்படுத்தப்பட்டது",
  "onboarding.audioPass": "ஒலி சோதனை வெற்றிகரமாக முடிந்தது. உங்கள் ஸ்பீக்கர் மற்றும் மைக்ரோஃபோன் செயல்படுகின்றன.",
  "onboarding.micRequesting": "மைக்ரோஃபோன் அணுகலை வழங்குகிறது...",
  "onboarding.micPlaying": "குரல் முகவர் பேசுகிறார் — கவனமாக கேளுங்கள்...",
  "onboarding.micListening": "தயவுசெய்து \"ஆம்\" அல்லது \"நான் உங்களை கேட்கிறேன்\" என்று சொல்லி உறுதிப்படுத்தவும்.",
  "onboarding.micAnalyzing": "உங்கள் பதிலைச் சரிபார்க்கிறது...",
  "onboarding.micFailed": "நாங்கள் உங்கள் குரலை கண்டறிய முடியவில்லை. தயவுசெய்து மீண்டும் முயற்சிக்கவும்.",
  "onboarding.micRetry": "மீண்டும் முயற்சிக்கவும், அல்லது ",
  "onboarding.micRequired": "இந்த பேச்சுக்கான மைக்ரோபோன் தேவை.",
  "onboarding.audioConfirmedShort": "ஒலி உறுதிப்படுத்தப்பட்டது",
  "onboarding.requestingAccess": "அணுகலை கோருகிறது...",
  "onboarding.stop": "நிறுத்து",
  "onboarding.analyzing": "விசாரணை செய்கிறேன்...",
  "onboarding.listening": "கேட்கிறேன்...",
  "onboarding.playAgain": "மீண்டும் வாசிக்கவும்",
  "onboarding.entireScreen": "முழு திரை",
  "onboarding.shareScreen": "திரையை பகிரவும்",
  "onboarding.screenCapture": "திரை பிடிப்பு",
  "onboarding.screenRequired": "இந்த பேச்சுக்கான திரை பகிர்வு தேவை.",
  "onboarding.screenDesc": "திரை பிடிப்புக்கு அனுமதி தேவை.",
  "onboarding.screenInstructions": "\"திரையை பகிரவும்\" என்பதைக் கிளிக் செய்த பிறகு, பாப்-அப் ஜன்னலில் \"முழு திரை\" ஐத் தேர்ந்தெடுத்து \"பகிரவும்\" என்பதைக் கிளிக் செய்யவும்.",
  "onboarding.screenDenied": "திரை பிடிப்பு மறுக்கப்பட்டது அல்லது ரத்து செய்யப்பட்டது.",
  "onboarding.preparing": "உங்கள் பேச்சை தயாரிக்கிறேன்...",
  "onboarding.moment": "இதற்கு ஒரு நிமிடம் மட்டுமே ஆகும்.",
  "onboarding.time": "நேரம்",
  "onboarding.times": "நேரங்கள்",
  "onboarding.integrityProtection": "கணினி அச்சுறுத்தல் பாதுகாப்பு செயல்படுத்தப்பட்டது",
  "common.status": "நிலை",
  "antiCheating.departureTitle": "பக்கம் விலகல் கண்டறியப்பட்டது",
  "antiCheating.departureDesc": "நீங்கள் பேச்சு பக்கம் விலகியுள்ளீர்கள் அல்லது டேப்ஸ்/ஜன்னைகளை மாற்றியுள்ளீர்கள். பேச்சின் அச்சுறுத்தல்களை உறுதி செய்ய, தயவுசெய்து இந்த பக்கத்தில் இருங்கள். மீண்டும் மீண்டும் விலகல் இந்த அமர்வை மதிப்பீட்டிற்காக குறிக்கிறது.",
  "antiCheating.understand": "நான் புரிந்துகொள்கிறேன்",
  "antiCheating.pasteTitle": "வெளியுறுப்பு ஒட்டுதல் கண்டறியப்பட்டது",
  "antiCheating.pasteDesc": "வெளியுறுப்பு உள்ளடக்கம் ஒட்டுவது அனுமதிக்கப்படவில்லை.",
  "antiCheating.multiScreenTitle": "பல திரைகள் கண்டறியப்பட்டன",
  "antiCheating.multiScreenDesc": "முன்னேற்றத்திற்கு கூடுதல் மானிட்டர்களை இணைப்பை துண்டிக்கவும்.",
  "antiCheating.maxDepartures": "அதிகபட்ச எச்சரிக்கைகள் அடைந்தது",
  "tour.welcomeTitle": "உங்கள் பேச்சுக்கு வரவேற்கிறேன்!",
  "tour.welcomeSubtitle": "பேச்சு இடைமுகத்தின் விரைவான சுற்றுப்பயணம்.",
  "tour.welcomeDesc": "நாங்கள் முக்கிய அம்சங்களை — ஒலி கட்டுப்பாடுகள், உரை, வெள்ளைபேடு மற்றும் மேலும் — நீங்கள் எங்கு எதுவும் உள்ளதைக் கண்டுபிடிக்க உதவுவோம்.",
  "tour.skipTour": "இப்போது தவிர்க்கவும்",
  "tour.takeTour": "விரைவான சுற்றுப்பயணம் எடுக்கவும்",
  "tour.completeTitle": "நீங்கள் அனைத்தும் தயார்!",
  "tour.completeSubtitle": "இப்போது பேச்சை தொடங்கலாம், அல்லது மற்றொரு பார்வைக்காக சுற்றுப்பயணத்தை மீண்டும் தொடங்கலாம்.",
  "tour.restartTour": "சுற்றுப்பயணத்தை மீண்டும் தொடங்கவும்",
  "tour.startInterview": "பேச்சை தொடங்கு",
  "publicInterview.notAvailable": "பேச்சு கிடைக்கவில்லை",
  "publicInterview.notAvailableDesc": "இந்த பேச்சு நீக்கப்பட்டிருக்கலாம் அல்லது இனி பதில்களை ஏற்கவில்லை.",
  "publicInterview.completed": "நன்றி!",
  "publicInterview.completedDesc": "உங்கள் நேர்முகம் வெற்றிகரமாக முடிந்தது. உங்கள் நேரம் மற்றும் சிந்தனையுடன் பதிலளிப்புக்கு நாங்கள் மதிப்பளிக்கிறோம்.",
